	/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/clang++ -pipe -stdlib=libc++ -O2 -fPIC -std=gnu++1z -Wall -Wextra -dM -E -o moc_predefs.h /usr/local/Qt-6.9.1/mkspecs/features/data/dummy.cpp

